  (12940828880568058152899620794803943716345734641868502631949730541000 * k * B^2 + 36969627639288035988606684673953911452387790458223862915537944717300 * c * B^2 - 26822055568034211334487156120670138208689788087983888094248690807650 * B^3 - 305612191964906202558666887433578434162755413678200005367993834084800 * k * c - 155013978266058912011421805477064866361669582291652849696279772671680 * c^2 + 307710528183317125662137102395264924652180722393168100483533180387800 * k * B - 133771328566226360951815334045098771567586589614909223716938738279200 * c * B + 94221990082605954389905913725423694942910906294494005234442108217915 * B^2 + 75171849857700030576590868515900573741843659362838278967102240155840 * k + 135012439637240087814700542424448511915244278049077902811363275091952 * c - 101895265410355703795499419957998428328934226397541613840171847463352 * B - 24897004899824590532694339709207994918458872346950854538751371393024)

theorem step147 (s k c B : ℂ) :
    1 * g147 s k c B = (1) * g146 s k c B := by
  dsimp only [g147, g146] <;> ring

theorem zero147 (s k c B : ℂ) (h0 : g0 s k c B = 0) (h1 : g1 s k c B = 0) (h2 : g2 s k c B = 0) (h3 : g3 s k c B = 0) :
    g147 s k c B = 0 := by
  have he := step147 s k c B
  have h146 := zero146 s k c B h0 h1 h2 h3
  simp only [h146, mul_zero, add_zero] at he
  exact (mul_eq_zero.mp he).resolve_left (by norm_num)

end Mordell.Elimination
