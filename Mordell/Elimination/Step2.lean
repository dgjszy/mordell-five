  (75346616542052669614000 * s * c^4 * B + 141712694039463009037500 * s * k^2 * c * B^2 - 282122455202408896935000 * s * k * c^2 * B^2 - 5137052263271797806000 * s * c^3 * B^2 + 115563003194029659665625 * s * k^2 * B^3 + 16511953703373635805000 * s * k * c * B^3 + 34226755185973440000 * s * k^2 * c^2 + 619808880257642943592000 * s * c^4 - 4455964323081466364100000 * s * k^3 * B + 1720442948467328849910000 * s * k^2 * c * B - 2304785437227940591692000 * s * k * c^2 * B - 29350355454961073220600 * s * c^3 * B + 1041219221585724162466875 * s * k^2 * B^2 - 11450822344478050130250 * s * k * c * B^2 + 10615402831259808278700 * s * c^2 * B^2 + 32598210036827497929750 * s * k * B^3 - 4463169561720050683050 * s * c * B^3 + 247679305550604537075 * s * B^4 - 30804079667376096000 * s * k^2 * c - 1381624595338403111904000 * s * k * c^2 + 364061629696895515342560 * s * c^3 + 3707820494795926235385000 * s * k^2 * B - 1385083744410295078229400 * s * k * c * B + 175016042281020479102595 * s * c^2 * B - 119615176766307114948600 * s * k * B^2 - 34390202969289820505010 * s * c * B^2 + 1607610182422490016795 * s * B^3 + 6930917925159621600 * s * k^2 + 601813130586325204633920 * s * k * c - 185412239590875283106652 * s * c^2 - 556152432971619572044920 * s * k * B + 211435126940278598162448 * s * c * B - 36428595172093172326284 * s * B^2 - 68035991710667450696352 * s * k + 22678663903555816898784 * s * c - 5039703089679070421952 * s * B + 6393571014000000 * B^2 + 41244905198700000 * B - 19936633984170292500)

theorem step53 (s k c B : ℂ) :
    1 * g53 s k c B = (-1) * g52 s k c B := by
  dsimp only [g53, g52] <;> ring

theorem zero53 (s k c B : ℂ) (h0 : g0 s k c B = 0) (h1 : g1 s k c B = 0) (h2 : g2 s k c B = 0) (h3 : g3 s k c B = 0) :
    g53 s k c B = 0 := by
  have he := step53 s k c B
  have h52 := zero52 s k c B h0 h1 h2 h3
  simp only [h52, mul_zero, add_zero] at he
  exact (mul_eq_zero.mp he).resolve_left (by norm_num)

end Mordell.Elimination
